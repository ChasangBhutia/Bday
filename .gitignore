# ========================================================
# Production Git Ignore for Birthday Surprise Application
# ========================================================

# 1. Dependencies
node_modules/
*/node_modules/
**/node_modules/

# 2. Environment Variables & Secret Credentials (NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
!.env.example
!*/.env.example

# 3. Production Build Outputs
dist/
dist-ssr/
client/dist/
build/
*.local

# 4. Uploaded User Media (Preserve folder structure, ignore actual uploads)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/videos/
server/uploads/videos/*
!server/uploads/videos/.gitkeep

# 5. Operating System & Editor Files
.DS_Store
**/.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Temporary & Scratch Files
.temp/
tmp/
scratch/
