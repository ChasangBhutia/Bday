# ========================================================
# Frontend Client Environment Variables (.env)
# ========================================================

# Backend API Base URL
# - In local development (Vite): Leave blank ('') because Vite proxies /api and /uploads to http://localhost:5001
# - When deployed together with Express serving client/dist: Leave blank ('')
# - When deployed separately (e.g. Vercel frontend + Render backend): Set to your backend URL (no trailing slash)
# Example: VITE_API_URL=https://birthday-celebration-api.onrender.com
VITE_API_URL=https://bday-ved0.onrender.com
