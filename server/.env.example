# ========================================================
# Backend Server Environment Variables (.env)
# ========================================================

# Server Port (Default is 5001)
PORT=5001

# Application Environment ('development' or 'production')
# In 'production', Express serves the compiled client/dist static assets
NODE_ENV=production

# Allowed CORS Origins for cross-origin frontend requests
# - Use '*' to allow all domains
# - Or provide comma-separated domains (e.g. https://my-app.vercel.app,http://localhost:5173)
CORS_ORIGIN=*

# MongoDB Database Connection String (Atlas or Local)
# Note: If credentials are missing or DB is unreachable, the server automatically
# operates with zero downtime in high-speed In-Memory Cache mode!
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.lz6ak9x.mongodb.net/Birthday?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/birthday_celebrations
MONGODB_URI=mongodb://127.0.0.1:27017/birthday_celebrations
